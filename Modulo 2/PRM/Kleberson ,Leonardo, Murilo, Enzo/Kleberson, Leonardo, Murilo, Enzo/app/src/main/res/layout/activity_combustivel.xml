<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Combustivel">

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Comparador de Combustível"
        android:textAlignment="center"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/txtGasolina"
        android:layout_width="323dp"
        android:layout_height="75dp"
        android:layout_marginStart="61dp"
        android:layout_marginTop="99dp"
        android:ems="10"
        android:hint="Preço da Gasolina"
        android:inputType="numberDecimal"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView6" />

    <EditText
        android:id="@+id/txtEtanol"
        android:layout_width="311dp"
        android:layout_height="68dp"
        android:layout_marginStart="66dp"
        android:layout_marginTop="75dp"
        android:ems="10"
        android:hint="Preço do Etanol"
        android:inputType="numberDecimal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtGasolina" />

    <ImageView
        android:id="@+id/imgCombustivel"
        android:layout_width="150dp"
        android:layout_height="121dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtEtanol"
        app:srcCompat="@drawable/ic_launcher_foreground" />

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="32dp"
        android:text="Calcular"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgCombustivel" />

    <Button
        android:id="@+id/btnSairCombustivel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="92dp"
        android:layout_marginTop="32dp"
        android:text="Sair"
        app:layout_constraintStart_toEndOf="@+id/btnCalcular"
        app:layout_constraintTop_toBottomOf="@+id/imgCombustivel" />

    <TextView
        android:id="@+id/lblResposta"
        android:layout_width="216dp"
        android:layout_height="82dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="52dp"
        android:text="..."
        app:layout_constraintStart_toEndOf="@+id/imgCombustivel"
        app:layout_constraintTop_toBottomOf="@+id/txtEtanol" />

</androidx.constraintlayout.widget.ConstraintLayout>