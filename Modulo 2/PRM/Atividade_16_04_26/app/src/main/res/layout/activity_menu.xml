<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Menu">

    <TextView
        android:id="@+id/lblTitulo2"
        android:layout_width="264dp"
        android:layout_height="78dp"
        android:layout_marginStart="72dp"
        android:layout_marginTop="28dp"
        android:text="Bem-Vindo(a)"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnNav"
        android:layout_width="146dp"
        android:layout_height="57dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="168dp"
        android:text="Navegar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnLigar"
        android:layout_width="137dp"
        android:layout_height="54dp"
        android:layout_marginStart="76dp"
        android:layout_marginTop="92dp"
        android:text="Ligar"
        app:layout_constraintStart_toEndOf="@+id/btnNav"
        app:layout_constraintTop_toBottomOf="@+id/lblTitulo2" />

    <Button
        android:id="@+id/btnCompartilhar"
        android:layout_width="147dp"
        android:layout_height="58dp"
        android:layout_marginStart="45dp"
        android:layout_marginTop="37dp"
        android:text="Compartilhar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnNav" />

    <Button
        android:id="@+id/btnCâmera"
        android:layout_width="121dp"
        android:layout_height="63dp"
        android:layout_marginStart="91dp"
        android:layout_marginTop="31dp"
        android:text="Câmera"
        app:layout_constraintStart_toEndOf="@+id/btnCompartilhar"
        app:layout_constraintTop_toBottomOf="@+id/btnLigar" />

    <Button
        android:id="@+id/btnGaleira"
        android:layout_width="156dp"
        android:layout_height="53dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="55dp"
        android:text="Galeria"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCompartilhar" />

    <Button
        android:id="@+id/btnMap"
        android:layout_width="145dp"
        android:layout_height="55dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="64dp"
        android:text="Maps"
        app:layout_constraintStart_toEndOf="@+id/btnGaleira"
        app:layout_constraintTop_toBottomOf="@+id/btnCâmera" />

    <Button
        android:id="@+id/btnEmail"
        android:layout_width="119dp"
        android:layout_height="75dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="56dp"
        android:text="Email"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnGaleira" />

    <Button
        android:id="@+id/btnCalendario"
        android:layout_width="145dp"
        android:layout_height="60dp"
        android:layout_marginStart="76dp"
        android:layout_marginTop="64dp"
        android:text="Calendario"
        app:layout_constraintStart_toEndOf="@+id/btnEmail"
        app:layout_constraintTop_toBottomOf="@+id/btnMap" />

    <Button
        android:id="@+id/btnFechar"
        android:layout_width="139dp"
        android:layout_height="57dp"
        android:layout_marginStart="136dp"
        android:layout_marginTop="300dp"
        android:text="Fechar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCompartilhar" />
</androidx.constraintlayout.widget.ConstraintLayout>