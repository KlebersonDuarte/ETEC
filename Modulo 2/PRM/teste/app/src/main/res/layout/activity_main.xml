<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/lblTitulo"
        android:layout_width="175dp"
        android:layout_height="57dp"
        android:layout_marginStart="112dp"
        android:layout_marginTop="34dp"
        android:text="O Mago"
        android:textAlignment="center"
        android:textColor="#673AB7"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/txtNome"
        android:layout_width="313dp"
        android:layout_height="79dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"
        android:ems="10"
        android:hint="Nome do Mago"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblTitulo" />

    <EditText
        android:id="@+id/txtClasse"
        android:layout_width="308dp"
        android:layout_height="69dp"
        android:layout_marginStart="34dp"
        android:layout_marginTop="18dp"
        android:ems="10"
        android:fontFamily="sans-serif"
        android:hint="Você é main oq?"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtNome" />

    <EditText
        android:id="@+id/txtFundos"
        android:layout_width="309dp"
        android:layout_height="61dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="28dp"
        android:ems="10"
        android:hint="Quanto de gold vc tem?"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtClasse" />

    <Button
        android:id="@+id/btnEnviar"
        android:layout_width="307dp"
        android:layout_height="57dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="42dp"
        android:text="Mais gold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtJuros" />

    <Button
        android:id="@+id/btnLimpar"
        android:layout_width="307dp"
        android:layout_height="63dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="12dp"
        android:text="Limpar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnEnviar" />

    <Button
        android:id="@+id/btnSair"
        android:layout_width="305dp"
        android:layout_height="61dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="40dp"
        android:text="Sair"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnLimpar" />

    <EditText
        android:id="@+id/txtJuros"
        android:layout_width="311dp"
        android:layout_height="54dp"
        android:layout_marginStart="42dp"
        android:layout_marginTop="24dp"
        android:ems="10"
        android:hint="Juros "
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtFundos" />
</androidx.constraintlayout.widget.ConstraintLayout>